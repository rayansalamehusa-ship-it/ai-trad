# مفتاح Google AI Studio (Gemini) — لوضع الذكاء الاصطناعي. احصل عليه من: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# النماذج (اختياري) — يمكن تغييرها من تبويب الإعدادات
WORKER_MODEL=gemini/gemini-3.5-flash
CEO_MODEL=gemini/gemini-3.5-flash

# تحكم Telegram (اختياري): أنشئ بوتاً عبر @BotFather، وضع الـ token ومعرّف حسابك الخاص في Chat ID.
# البوت يقبل أوامر من هذا المعرّف فقط ويعمل بوضع PAPER ONLY.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# المسح التلقائي: قائمة المتابعة تقبل عملات رقمية وذهب وفوركس (مثال: BTC,ETH,XAU/USD,EUR/USD,USD/JPY)
WATCHLIST=BTC,ETH,SOL,XAU/USD,EUR/USD,USD/JPY,GBP/USD
AUTO_SCAN_MIN=0
AUTO_MODE=swing
AUTO_CAPITAL=1000

# الوكيل الباحث عن الاستراتيجيات: كل كم ساعة يبحث تلقائياً (0 = مطفأ). LAB_USE_LLM=1 يضيف اقتراحات Gemini
LAB_AUTO_HOURS=0
LAB_USE_LLM=0

# Grok (xAI): نبض منصة X + رأي ثانٍ — مفتاح من console.x.ai
XAI_API_KEY=
GROK_MODEL=grok-4.7
GROK_REVIEW=1

# MetaTrader 5 Demo: log into a DEMO account in the local MT5 terminal first.
# Optional broker-specific symbol mapping, comma-separated: BTC/USDT=BTCUSDm,EUR/USD=EURUSD
MT5_SYMBOL_MAP=
